# Copy to .env for local development. Never commit real values.
# Fine-grained personal access token, limited to the repositories you allow.
GITHUB_TOKEN=
# For github_auth mode 'app': the path of the App's private key, instead of GITHUB_TOKEN.
GITHUB_APP_PRIVATE_KEY_FILE=
# Only for the live test suite: a sandbox repository the token can read.
REPOWARD_LIVE_REPO=
# Only for the live test suite: a token with write access to the sandboxes, and a private one.
GITHUB_WRITE_TOKEN=
REPOWARD_LIVE_PRIVATE_REPO=
# Only for the live GitHub App tests.
REPOWARD_LIVE_APP_CLIENT_ID=
REPOWARD_LIVE_APP_INSTALLATION_ID=
REPOWARD_LIVE_REVIEW=
